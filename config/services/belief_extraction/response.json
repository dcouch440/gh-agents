{
  "type": "object",
  "required": ["beliefs"],
  "properties": {
    "beliefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content", "reasoning", "belief_type", "confidence"],
        "properties": {
          "content": { "type": "string", "description": "The extracted belief as a clear, atomic claim" },
          "reasoning": { "type": "string", "description": "Why this was identified as a belief" },
          "belief_type": { "type": "string", "enum": ["fact", "opinion", "assumption", "requirement", "constraint", "goal", "risk", "preference", "insight"] },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "confidence_justification": { "type": "string", "description": "Why this confidence level was assigned" },
          "semantic_tags": { "type": "array", "items": { "type": "string" } },
          "emotional_tone": { "type": "string" },
          "cross_source_tension": { "type": "string" }
        }
      }
    }
  }
}
