# nexor Environment Configuration
# Copy this file to .env and fill in your values

# Required: Anthropic API key for LLM access
ANTHROPIC_API_KEY=sk-ant-...

# Optional: GitHub personal access token (for GitHub integration)
GITHUB_TOKEN=ghp_...

# Optional: Log level (info, debug, trace)
RUST_LOG=info

# Optional: PostgreSQL connection URL (defaults to local Docker Compose instance)
DATABASE_URL=postgres://nexor:nexor@localhost:5432/nexor

# Optional: Project directory to mount (for Docker)
# PROJECT_DIR=/path/to/your/project
