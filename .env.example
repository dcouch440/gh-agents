# nexor Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────

# Optional: PostgreSQL connection URL (defaults to local Docker Compose instance)
DATABASE_URL=postgres://nexor:nexor@localhost:5432/nexor

# Optional: Max DB connection pool size (default: 50)
# DB_MAX_CONNECTIONS=50

# ── Auth ──────────────────────────────────────────────────────────────────

# Required in production: secret used to sign JWTs. Generate with `openssl rand -hex 32`
JWT_SECRET=

# Optional: development | production (default: development)
# RUST_ENV=development

# ── LLM Providers ────────────────────────────────────────────────────────

# Required: DeepInfra API key. DeepInfra is the active provider by default
# (see ACTIVE_PROVIDER in src/constants.rs). All three model tiers run the
# same DeepSeek model and differ only by reasoning effort, which is set
# per-agent in config/**/config.yaml.
DEEPINFRA_API_KEY=

# Optional: fallback model for DeepInfra calls that do not name one
# (default: deepseek-ai/DeepSeek-V4-Flash-0731).
#
# This is NOT a global model override. Agents run on the MODEL_TIER1/2/3
# constants in src/constants.rs, which every execution path passes
# explicitly, so setting this alone does not change the model any agent
# uses — change the tier constants for that.
# DEEPINFRA_MODEL=

# Optional: xAI (Grok) API key. Only needed if ACTIVE_PROVIDER is switched
# back to xAI, or for agents pinned to the xAI provider.
# XAI_API_KEY=

# Optional: xAI model override
# XAI_MODEL=

# Optional: Anthropic API key, only needed if using Anthropic as a provider
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Anthropic model override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: enable local Ollama provider (default: false)
# NEXOR_OLLAMA_ENABLED=false

# Optional: Ollama model name, required if NEXOR_OLLAMA_ENABLED=true
# OLLAMA_MODEL=

# Optional: Ollama base URL (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# ── Web Tools ────────────────────────────────────────────────────────────

# Required for the brave_search tool. Free tier allows 1 query/second and
# 2000 queries/month; the tool reads the remaining quota from Brave's
# x-ratelimit-remaining response header.
BRAVE_SEARCH_API_KEY=

# How agent web traffic leaves. Default is "vpn": brave_search and
# read_webpage route through the egress proxy below and REFUSE to run when
# it is not configured. There is no automatic fallback — a silent downgrade
# would leak the agent's queries while looking like success.
#
# NOTE: this repo does not ship an egress proxy. wg-easy is a WireGuard peer
# manager, not a forward proxy, so "vpn" mode needs an HTTP proxy (squid,
# tinyproxy, ...) that you run and point NEXOR_VPN_PROXY_URL at. Until then
# both web tools refuse every call in the default mode.
#
# Set to "direct" for local development. In direct mode this process resolves
# hostnames itself, and every resolved address is checked against the same
# private/loopback/link-local rules as a literal IP — but the check is
# advisory: the connection resolves again afterwards. Do not use "direct" on
# a host with reachable internal services. Refused when RUST_ENV=production.
# NEXOR_WEB_EGRESS_MODE=vpn

# URL of the HTTP egress proxy. Required when NEXOR_WEB_EGRESS_MODE=vpn.
# The proxy is trusted configuration: it is not health-checked, and whatever
# network it resolves and connects on is the one agents reach.
# NEXOR_VPN_PROXY_URL=http://127.0.0.1:3128

# ── Server ───────────────────────────────────────────────────────────────

# Optional: comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:5173

# Optional: directory to serve the built frontend from (default: ui/dist)
# NEXOR_STATIC_DIR=ui/dist

# Optional: disable API rate limiting entirely (default: false)
# Limits are keyed per signed-in session rather than per IP, so ordinary use --
# including several people behind one address -- should never reach them. Leave
# this off unless you are load-testing and mean to run the server unprotected.
# NEXOR_SKIP_RATE_LIMIT=false

# Optional: host directory to mount as the agent workspace (for Docker)
# WORKSPACE_MOUNT_POINT=/path/to/your/project

# ── GitHub ───────────────────────────────────────────────────────────────

# Optional: GitHub personal access token (for GitHub integration)
GITHUB_TOKEN=ghp_...

# ── Debug ────────────────────────────────────────────────────────────────

# Optional: verbose debug logging for the streaming layer (default: false)
# NEXOR_DEBUG_STREAM=false

# Optional: Log level (info, debug, trace)
RUST_LOG=info

# ── S3 / System Store ────────────────────────────────────────────────────

# Optional: S3-compatible endpoint (defaults to local MinIO instance)
# S3_ENDPOINT=http://localhost:9000

# Optional: S3 bucket name (default: nexor-system-store)
# S3_BUCKET=nexor-system-store

# ── WireGuard VPN (wg-easy) ──────────────────────────────────────────────
# Required when workflows have vpn_enabled=true

# WGEASY_API_URL=http://localhost:51821
# WGEASY_PASSWORD=changeme

# Bcrypt hash of WGEASY_PASSWORD, consumed by the wg-easy container in
# docker-compose.yml. Generate with: docker run --rm ghcr.io/wg-easy/wg-easy wgpw '<password>'
# WGEASY_PASSWORD_HASH=
