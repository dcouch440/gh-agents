FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        build-essential \
        python3 \
        python3-pip \
        python3-venv && \
    rm -rf /var/lib/apt/lists/*

# Allow pip install without --break-system-packages (Debian 12 PEP 668)
RUN printf "[global]\nbreak-system-packages = true\n" > /etc/pip.conf

# Symlink python -> python3 so agents don't have to guess
RUN ln -s /usr/bin/python3 /usr/bin/python

RUN mkdir -p /workspace /workspace-base /tmp/overlay/upper /tmp/overlay/work
WORKDIR /workspace

CMD ["sleep", "infinity"]
