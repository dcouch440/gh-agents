 WS5: API Route Protection                                                                                                                                                                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                                                                                                                                                                                         
 Modify: src/server/mod.rs — add auth middleware layer on protected routes:                                                                                                                                                                                                                                                                                                                                                              
 async fn require_auth(State(state): State<AppState>, request: Request, next: Next) -> Result<Response, StatusCode> {                                                                                                                                                                                                                                                                                                                    
     // validate Bearer token, reject 401 if missing/invalid                                                                                                                                                                                                                                                                                                                                                                             
 }                                                                                                                                                                                                                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                                                                                                                                                                                                         
 let protected_routes = Router::new()                                                                                                                                                                                                                                                                                                                                                                                                    
     .route(/* ... */)                                                                                                                                                                                                                                                                                                                                                                                                                   
     .layer(middleware::from_fn_with_state(state.clone(), require_auth));                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                         
 This is defense-in-depth — handlers already extract AuthUser, but the middleware catches any handler that forgets.                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                                                                                                                         
